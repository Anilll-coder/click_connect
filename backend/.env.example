# Copy to .env and fill in real values. Never commit the real .env file.

# Gemini API key for the AI writing assistant (/api/chat). Keep this
# server-side only — it must never be exposed to the frontend.
api_key=your-gemini-api-key-here

# Secret used to sign JWTs. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating this value invalidates every existing login session.
secret_key=change-me-to-a-long-random-value

# Present for compatibility with existing config; access tokens currently
# expire after a fixed 60 minutes (see routes/auth.py).
access_token_expire_minutes=60

# SQLAlchemy connection string for your Supabase Postgres instance, e.g.:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
database_url=postgresql+psycopg://user:password@host:5432/dbname

# Optional: only needed if this app is ever scaled to multiple instances.
# Points rate limiting at a shared Redis store instead of per-process
# memory (see utils/ratelimit.py). Leave unset for a single instance.
# RATE_LIMIT_STORAGE_URL=redis://localhost:6379
